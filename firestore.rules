rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Configurações da Empresa
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(settingId);
    }

    // Registo de Colaboradores (Dados Pessoais e Fiscais)
    match /employees/{employeeId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(employeeId);
    }

    // Períodos e Processamentos Salariais
    match /payroll_periods/{periodId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(periodId);
    }
  }
}
