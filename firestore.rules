rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Healthcheck / Connection check
    match /test/{docId} {
      allow read, write: if true;
    }

    // Configurações da Empresa
    match /settings/{settingId} {
      allow read, write: if isValidId(settingId);
    }

    // Registo de Colaboradores (Dados Pessoais e Fiscais)
    match /employees/{employeeId} {
      allow read, write: if isValidId(employeeId);
    }

    // Períodos e Processamentos Salariais
    match /payroll_periods/{periodId} {
      allow read, write: if isValidId(periodId);
    }
  }
}
